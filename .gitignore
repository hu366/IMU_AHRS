# Project documentation: publish only the root README. Keep third-party
# licenses and source-origin notices with their vendored components.
/doc/
*.md
*.markdown
*.mdx
*.rst
*.adoc
!/README.md
!firmware/components/**/LICENSE
!firmware/components/**/ORIGIN.md
*.rar
*.zip
*.pdf

# Local capture logs
/.esp-com10-*.log
/.pc-sync-*.log

# ESP-IDF
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# 3.3 generated Allan outputs (keep analysis/data/)
pc/analysis/out/*
!pc/analysis/out/.gitkeep
!pc/analysis/out/vqf_vs_madgwick.csv
pc/analysis/out/vqf_compare.txt
pc/analysis/data/still.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
